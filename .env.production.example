# Founders Hut - Production Environment Template
NODE_ENV=production
PORT=5001
CORS_ORIGIN=https://app.foundershut.com
VITE_API_BASE_URL=https://api.foundershut.com/api/v1

# PostgreSQL Connection String (Production Pool)
DATABASE_URL="postgresql://fh_prod_user:SECURE_PASSWORD@postgres.internal:5432/founders_hut_prod?schema=public&sslmode=require"

# Mandatory High-Entropy Secrets (Must be set, system will fail to start if empty)
JWT_SECRET="GENERATE_HIGH_ENTROPY_256BIT_SECRET_KEY_HERE"
JWT_REFRESH_SECRET="GENERATE_HIGH_ENTROPY_256BIT_REFRESH_KEY_HERE"

STORAGE_SIGNING_SECRET="GENERATE_HIGH_ENTROPY_STORAGE_KEY_HERE"
AWS_ACCESS_KEY_ID="PROD_AWS_KEY_ID"
AWS_SECRET_ACCESS_KEY="PROD_AWS_SECRET"
S3_BUCKET_NAME="founders-hut-verification-docs-prod"
S3_REGION="us-west-2"

# Notification Provider
POSTMARK_SERVER_TOKEN="PROD_POSTMARK_SERVER_TOKEN"
