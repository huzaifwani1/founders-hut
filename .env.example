# Founders Hut - General Environment Template
NODE_ENV=development
PORT=5001
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL for Production / SQLite for Local Dev)
DATABASE_URL="file:./dev.db"

# JWT Secret Keys (Generate secure 256-bit secrets for Production)
JWT_SECRET="replace_with_secure_256bit_random_secret_string"
JWT_REFRESH_SECRET="replace_with_secure_256bit_refresh_secret_string"

# Storage & Signing Configuration
STORAGE_SIGNING_SECRET="replace_with_storage_signing_secret"
S3_BUCKET_NAME=""
S3_REGION="us-east-1"

# External Notification Integrations (Optional)
POSTMARK_API_KEY=""
RESEND_API_KEY=""
